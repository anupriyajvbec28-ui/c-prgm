#include <stdio.h>
#include <stdlib.h>

int main() {
    int num;
    if (scanf("%d", &num) != 1) {
        return 1;
    }
    
    int* arr = (int*)malloc(num * sizeof(int));
    for (int i = 0; i < num; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 1;
        }
    }
    
    for (int i = 0; i < num / 2; i++) {
        int temp = arr[i];
        arr[i] = arr[num - 1 - i];
        arr[num - 1 - i] = temp;
    }
    
    for (int i = 0; i < num; i++) {
        printf("%d", arr[i]);
        if (i != num - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    free(arr);
    return 0;
}
