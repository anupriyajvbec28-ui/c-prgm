#include <stdlib.h>
#include <string.h>

void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

void backtrack(int* nums, int numsSize, int begin, int** results, int* returnSize) {
    if (begin == numsSize) {
        results[*returnSize] = (int*)malloc(numsSize * sizeof(int));
        memcpy(results[*returnSize], nums, numsSize * sizeof(int));
        (*returnSize)++;
        return;
    }
    
    for (int i = begin; i < numsSize; i++) {
        swap(&nums[begin], &nums[i]);
        backtrack(nums, numsSize, begin + 1, results, returnSize);
        swap(&nums[begin], &nums[i]);
    }
}

int** permute(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    int totalPermutations = 1;
    for (int i = 1; i <= numsSize; i++) {
        totalPermutations *= i;
    }
    
    int** results = (int**)malloc(totalPermutations * sizeof(int*));
    *returnColumnSizes = (int*)malloc(totalPermutations * sizeof(int));
    *returnSize = 0;
    
    for (int i = 0; i < totalPermutations; i++) {
        (*returnColumnSizes)[i] = numsSize;
    }
    
    backtrack(nums, numsSize, 0, results, returnSize);
    
    return results;
}
