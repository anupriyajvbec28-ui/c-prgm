#include <stdio.h>
#include <stdlib.h>

struct TreeNode* build(int* preorder, int preStart, int preEnd, int* inorder, int inStart, int inEnd) {
    if (preStart > preEnd || inStart > inEnd) {
        return NULL;
    }

    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = preorder[preStart];
    root->left = NULL;
    root->right = NULL;

    int rootIdx = inStart;
    while (rootIdx <= inEnd) {
        if (inorder[rootIdx] == root->val) {
            break;
        }
        rootIdx++;
    }

    int leftTreeSize = rootIdx - inStart;

    root->left = build(preorder, preStart + 1, preStart + leftTreeSize, inorder, inStart, rootIdx - 1);
    root->right = build(preorder, preStart + leftTreeSize + 1, preEnd, inorder, rootIdx + 1, inEnd);

    return root;
}

struct TreeNode* buildTree(int* preorder, int preorderSize, int* inorder, int inorderSize) {
    return build(preorder, 0, preorderSize - 1, inorder, 0, inorderSize - 1);
}
