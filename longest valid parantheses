int longestValidParentheses(char* s) {
    int maxLen = 0;
    int length = 0;
    while (s[length] != 0) {
        length++;
    }
    
    if (length == 0) {
        return 0;
    }
    
    int* dp = (int*)calloc(length, sizeof(int));
    
    int i = 1;
    while (i < length) {
        if (s[i] == ')') {
            if (s[i - 1] == '(') {
                if (i >= 2) {
                    dp[i] = dp[i - 2] + 2;
                } else {
                    dp[i] = 2;
                }
            } else if (i - dp[i - 1] > 0 && s[i - dp[i - 1] - 1] == '(') {
                int prevValid = 0;
                if (i - dp[i - 1] >= 2) {
                    prevValid = dp[i - dp[i - 1] - 2];
                }
                dp[i] = dp[i - 1] + prevValid + 2;
            }
            if (dp[i] > maxLen) {
                maxLen = dp[i];
            }
        }
        i++;
    }
    
    free(dp);
    return maxLen;
}
