#include <stdlib.h>
#include <string.h>

char* multiply(char* num1, char* num2) {
    int len1 = strlen(num1);
    int len2 = strlen(num2);
    
    if ((len1 == 1 && num1[0] == '0') || (len2 == 1 && num2[0] == '0')) {
        char* zero = (char*)malloc(2 * sizeof(char));
        zero[0] = '0';
        zero[1] = '\0';
        return zero;
    }
    
    int maxLen = len1 + len2;
    int* result = (int*)calloc(maxLen, sizeof(int));
    
    for (int i = len1 - 1; i >= 0; i--) {
        for (int j = len2 - 1; j >= 0; j--) {
            int mul = (num1[i] - '0') * (num2[j] - '0');
            int p1 = i + j;
            int p2 = i + j + 1;
            
            int sum = mul + result[p2];
            result[p2] = sum % 10;
            result[p1] += sum / 10;
        }
    }
    
    char* resStr = (char*)malloc((maxLen + 1) * sizeof(char));
    int idx = 0;
    int start = 0;
    
    while (start < maxLen && result[start] == 0) {
        start++;
    }
    
    while (start < maxLen) {
        resStr[idx++] = result[start++] + '0';
    }
    resStr[idx] = '\0';
    
    free(result);
    return resStr;
}
