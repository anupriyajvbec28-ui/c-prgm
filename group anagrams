#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* original;
    char* sorted;
    int index;
} Word;

int compareChars(const void* a, const void* b) {
    return *(const char*)a - *(const char*)b;
}

int compareWords(const void* a, const void* b) {
    return strcmp(((const Word*)a)->sorted, ((const Word*)b)->sorted);
}

char*** groupAnagrams(char** strs, int strsSize, int* returnSize, int** returnColumnSizes) {
    if (strsSize == 0) {
        *returnSize = 0;
        return NULL;
    }

    Word* words = (Word*)malloc(strsSize * sizeof(Word));
    for (int i = 0; i < strsSize; i++) {
        words[i].original = strs[i];
        words[i].index = i;
        int len = strlen(strs[i]);
        words[i].sorted = (char*)malloc((len + 1) * sizeof(char));
        strcpy(words[i].sorted, strs[i]);
        qsort(words[i].sorted, len, sizeof(char), compareChars);
    }

    qsort(words, strsSize, sizeof(Word), compareWords);

    char*** result = (char***)malloc(strsSize * sizeof(char**));
    *returnColumnSizes = (int*)malloc(strsSize * sizeof(int));
    int groupCount = 0;

    int i = 0;
    while (i < strsSize) {
        int j = i;
        while (j < strsSize && strcmp(words[i].sorted, words[j].sorted) == 0) {
            j++;
        }

        int groupSize = j - i;
        result[groupCount] = (char**)malloc(groupSize * sizeof(char*));
        (*returnColumnSizes)[groupCount] = groupSize;

        for (int k = 0; k < groupSize; k++) {
            result[groupCount][k] = words[i + k].original;
        }

        groupCount++;
        i = j;
    }

    *returnSize = groupCount;

    for (int k = 0; k < strsSize; k++) {
        free(words[k].sorted);
    }
    free(words);

    return result;
}
