int isValid(char* s) {
    char stack[10005];
    int top = -1;
    int i = 0;
    
    while (s[i] != 0) {
        char c = s[i];
        
        if (c == '(' || c == '{' || c == '[') {
            top++;
            stack[top] = c;
        } 
        else {
            if (top == -1) {
                return 0;
            }
            
            char topChar = stack[top];
            
            if ((c == ')' && topChar == '(') || 
                (c == '}' && topChar == '{') || 
                (c == ']' && topChar == '[')) {
                top--;
            } else {
                return 0;
            }
        }
        i++;
    }
    
    return top == -1;
}
