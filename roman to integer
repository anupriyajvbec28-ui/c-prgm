#include <string.h>

// Helper function to get the integer value of a single Roman character
int getRomanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int len = strlen(s);
    
    for (int i = 0; i < len; i++) {
        int current_value = getRomanValue(s[i]);
        
        // If there is a next character and its value is greater than the current one,
        // it means we are dealing with a subtractive form (like IV, IX, XL, XC, CD, CM)
        if (i + 1 < len && getRomanValue(s[i + 1]) > current_value) {
            total -= current_value;
        } else {
            total += current_value;
        }
    }
    
    return total;
}
