#include <stdbool.h>
#include <string.h>

bool isMatch(char* s, char* p) {
    int s_len = strlen(s);
    int p_len = strlen(p);
    
    // Create a 2D DP array initialized to false
    bool dp[s_len + 1][p_len + 1];
    memset(dp, 0, sizeof(dp));
    
    // Base Case: Empty string matches empty pattern
    dp[0][0] = true;
    
    // Initialize first row: Deals with patterns like a*, a*b*, or .*
    for (int j = 1; j <= p_len; j++) {
        if (p[j - 1] == '*') {
            dp[0][j] = dp[0][j - 2];
        }
    }
    
    // Fill the DP table
    for (int i = 1; i <= s_len; i++) {
        for (int j = 1; j <= p_len; j++) {
            
            // Case 1: The current pattern character is a '*'
            if (p[j - 1] == '*') {
                // Scenario A: Count the '*' character as 0 occurrences (look 2 steps back)
                dp[i][j] = dp[i][j - 2];
                
                // Scenario B: Count the '*' as 1 or more occurrences if characters match
                char preceding_char = p[j - 2];
                if (preceding_char == s[i - 1] || preceding_char == '.') {
                    dp[i][j] = dp[i][j] || dp[i - 1][j];
                }
            } 
            // Case 2: The current pattern character matches the string character (or is '.')
            else if (p[j - 1] == s[i - 1] || p[j - 1] == '.') {
                dp[i][j] = dp[i - 1][j - 1];
            }
        }
    }
    
    // Return final answer
    return dp[s_len][p_len];
}
