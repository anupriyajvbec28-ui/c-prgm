#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* word;
    int id;
} WordMap;

int compareWords(const void* a, const void* b) {
    return strcmp(((WordMap*)a)->word, ((WordMap*)b)->word);
}

int getWordId(const char* str, int len, WordMap* uniqueWords, int uniqueCount) {
    int low = 0, high = uniqueCount - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        int cmp = strncmp(str, uniqueWords[mid].word, len);
        if (cmp == 0) return uniqueWords[mid].id;
        if (cmp < 0) high = mid - 1;
        else low = mid + 1;
    }
    return -1;
}

int compareStrings(const void* a, const void* b) {
    return strcmp(*(const char**)a, *(const char**)b);
}

int* findSubstring(char* s, char** words, int wordsSize, int* returnSize) {
    *returnSize = 0;
    if (!s || wordsSize == 0) return NULL;

    int sLen = strlen(s);
    int wordLen = strlen(words[0]);
    int totalLen = wordLen * wordsSize;
    if (sLen < totalLen) return NULL;

    char** sortedWords = (char**)malloc(wordsSize * sizeof(char*));
    for (int i = 0; i < wordsSize; i++) sortedWords[i] = words[i];
    qsort(sortedWords, wordsSize, sizeof(char*), compareStrings);

    WordMap* uniqueWords = (WordMap*)malloc(wordsSize * sizeof(WordMap));
    int* targetCount = (int*)calloc(wordsSize, sizeof(int));
    int uniqueCount = 0;

    for (int i = 0; i < wordsSize; i++) {
        if (i == 0 || strcmp(sortedWords[i], sortedWords[i - 1]) != 0) {
            uniqueWords[uniqueCount].word = sortedWords[i];
            uniqueWords[uniqueCount].id = uniqueCount;
            uniqueCount++;
        }
        targetCount[uniqueCount - 1]++;
    }

    int* currentCount = (int*)malloc(uniqueCount * sizeof(int));
    int* result = (int*)malloc(sLen * sizeof(int));
    
    int* wordIds = (int*)malloc(sLen * sizeof(int));
    for (int i = 0; i <= sLen - wordLen; i++) {
        wordIds[i] = getWordId(&s[i], wordLen, uniqueWords, uniqueCount);
    }

    for (int i = 0; i < wordLen; i++) {
        memset(currentCount, 0, uniqueCount * sizeof(int));
        int left = i;
        int right = i;
        int count = 0;

        while (right + wordLen <= sLen) {
            int wId = wordIds[right];
            right += wordLen;

            if (wId != -1) {
                currentCount[wId]++;
                count++;

                while (currentCount[wId] > targetCount[wId]) {
                    int leftWId = wordIds[left];
                    currentCount[leftWId]--;
                    left += wordLen;
                    count--;
                }

                if (count == wordsSize) {
                    result[(*returnSize)++] = left;
                }
            } else {
                memset(currentCount, 0, uniqueCount * sizeof(int));
                count = 0;
                left = right;
            }
        }
    }

    free(sortedWords);
    free(uniqueWords);
    free(targetCount);
    free(currentCount);
    free(wordIds);

    return result;
}
