int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) {
        return 0;
    }
    
    int writeIndex = 1;
    int readIndex = 1;
    
    while (readIndex < numsSize) {
        if (nums[readIndex] != nums[readIndex - 1]) {
            nums[writeIndex] = nums[readIndex];
            writeIndex++;
        }
        readIndex++;
    }
    
    return writeIndex;
}
