#include <stdio.h>
#include <stdlib.h>

int main() {
    int num;
    if (scanf("%d", &num) != 1) {
        return 1;
    }
    int *arr = (int*)malloc(num * sizeof(int));
    if (arr == NULL) {
        return 1;
    }
    for (int i = 0; i < num; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 1;
        }
    }
    int start = 0;
    int end = num - 1;
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
    for (int i = 0; i < num; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    free(arr);
    
    return 0;
}
