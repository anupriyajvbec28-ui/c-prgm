#include <stdio.h>

int main() {
    int arr[6][6];
    
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            if (scanf("%d", &arr[i][j]) != 1) {
                return 1;
            }
        }
    }
    
    /* The minimum possible value for an hourglass is 7 * -9 = -63 */
    int max_sum = -64;
    
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            int top = arr[i][j] + arr[i][j + 1] + arr[i][j + 2];
            int mid = arr[i + 1][j + 1];
            int bot = arr[i + 2][j] + arr[i + 2][j + 1] + arr[i + 2][j + 2];
            
            int current_sum = top + mid + bot;
            
            if (current_sum > max_sum) {
                max_sum = current_sum;
            }
        }
    }
    
    printf("%d\n", max_sum);
    
    return 0;
}
