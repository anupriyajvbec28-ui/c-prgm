#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 1;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 1;
        }
    }

    d = d % n;

    for (int i = 0; i < n; i++) {
        int target_index = (i + d) % n;
        printf("%d", arr[target_index]);
        if (i != n - 1) {
            printf(" ");
        }
    }
    printf("\n");

    free(arr);
    return 0;
}
