#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 1;

    char** stringList = (char**)malloc(n * sizeof(char*));
    for (int i = 0; i < n; i++) {
        stringList[i] = (char*)malloc(21 * sizeof(char));
        if (scanf("%s", stringList[i]) != 1) return 1;
    }

    int q;
    if (scanf("%d", &q) != 1) return 1;

    char query[21];
    for (int i = 0; i < q; i++) {
        if (scanf("%s", query) != 1) break;
        
        int count = 0;
        for (int j = 0; j < n; j++) {
            if (strcmp(stringList[j], query) == 0) {
                count++;
            }
        }
        printf("%d\n", count);
    }

    for (int i = 0; i < n; i++) {
        free(stringList[i]);
    }
    free(stringList);

    return 0;
}
